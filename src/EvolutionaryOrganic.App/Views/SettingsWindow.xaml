<Window x:Class="EvolutionaryOrganic.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
        <TextBlock Text="Theme" Style="{StaticResource SecondaryText}" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
            <RadioButton x:Name="SystemTheme" Content="System default" GroupName="Theme" Margin="0,0,16,0" />
            <RadioButton x:Name="LightTheme" Content="Light" GroupName="Theme" Margin="0,0,16,0" />
            <RadioButton x:Name="DarkTheme" Content="Dark" GroupName="Theme" />
        </StackPanel>

        <TextBlock Text="Rendering" Style="{StaticResource SectionHeader}" />
        <CheckBox x:Name="ShadowsCheck" Content="Shadows" />
        <CheckBox x:Name="AmbientOcclusionCheck" Content="Ambient occlusion (soft contact shading)" />
        <CheckBox x:Name="AntialiasingCheck" Content="Anti-aliasing (4× MSAA)" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="OK" Width="90" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="OnOk" />
            <Button Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
