<Window x:Class="EvolutionaryOrganic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EvolutionaryOrganic.App.ViewModels"
        xmlns:v="clr-namespace:EvolutionaryOrganic.App.Views"
        Title="Evolutionary Organic"
        Width="1500" Height="960" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewRandomCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding BackCommand}" />
        <KeyBinding Key="F5" Command="{Binding RerollCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Open" Executed="OnImportGenome" />
        <CommandBinding Command="Save" Executed="OnExportGenome" />
        <CommandBinding Command="Print" Executed="OnExportImage" />
    </Window.CommandBindings>

    <Window.Resources>
        <DataTemplate x:Key="SlotTemplate" DataType="{x:Type vm:CreationSlotViewModel}">
            <Border x:Name="Frame" Margin="4" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <v:CreationView Morphology="{Binding Morphology}" />

                    <StackPanel Margin="10,8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryText}" />
                    </StackPanel>

                    <TextBlock Text="Growing…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource SecondaryText}" IsHitTestVisible="False"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Error}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />

                    <Button Content="Select" Margin="0,0,0,10" Padding="18,4"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            ToolTip="Make this mutant the current creation"
                            Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                            IsEnabled="{Binding CanSelect}"
                            Visibility="{Binding IsMutant, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Re-roll" Margin="0,0,0,10" Padding="18,4"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Style="{DynamicResource AccentButtonStyle}"
                            ToolTip="Breed a fresh set of eight mutants (F5)"
                            Command="{Binding RerollCommand}"
                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:GenomeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Margin="0,3">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="18">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <Ellipse Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{Binding Swatch}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Properties}" Margin="18,1,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SecondaryText}">
                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New random creation" InputGestureText="Ctrl+N" Command="{Binding NewRandomCommand}" />
                <Separator />
                <MenuItem Header="_Import genome…" InputGestureText="Ctrl+O" Command="Open" />
                <MenuItem Header="_Export genome…" InputGestureText="Ctrl+S" Command="Save" />
                <MenuItem Header="Export _image…" InputGestureText="Ctrl+P" Command="Print" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Evolution">
                <MenuItem Header="_Re-roll mutants" InputGestureText="F5" Command="{Binding RerollCommand}" />
                <MenuItem Header="_Back to previous" InputGestureText="Ctrl+Z" Command="{Binding BackCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings…" Click="OnSettings" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource SlotTemplate}" Margin="6" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="3" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Margin="0,10,10,10" Padding="14" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Genome" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource SecondaryText}">
                            <Run Text="Surface: " /><Run Text="{Binding SurfaceSummary, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Style="{StaticResource SecondaryText}"
                               Text="Drag to rotate · wheel or right-drag to zoom · middle or Shift-drag to pan · double-click to reset view" />
                    <TreeView ItemsSource="{Binding GenomeTree}" BorderThickness="0" Background="Transparent">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
