<Window x:Class="EvolutionaryOrganic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EvolutionaryOrganic.App.ViewModels"
        xmlns:v="clr-namespace:EvolutionaryOrganic.App.Views"
        xmlns:local="clr-namespace:EvolutionaryOrganic.App"
        Title="{Binding WindowTitle}"
        Width="1500" Height="960" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewRandomCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding BackCommand}" />
        <KeyBinding Key="F5" Command="{Binding RerollCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.NewProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="SaveAs" />
        <KeyBinding Key="I" Modifiers="Control" Command="{x:Static local:MainWindow.ImportGenomeCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{x:Static local:MainWindow.ExportGenomeCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewProjectCommand}" Executed="OnNewProject" />
        <CommandBinding Command="Open" Executed="OnOpenProject" />
        <CommandBinding Command="Save" Executed="OnSaveProject" />
        <CommandBinding Command="SaveAs" Executed="OnSaveProjectAs" />
        <CommandBinding Command="{x:Static local:MainWindow.ImportGenomeCommand}" Executed="OnImportGenome" />
        <CommandBinding Command="{x:Static local:MainWindow.ExportGenomeCommand}" Executed="OnExportGenome" />
        <CommandBinding Command="Print" Executed="OnExportImage" />
    </Window.CommandBindings>

    <Window.Resources>
        <DataTemplate x:Key="SlotTemplate" DataType="{x:Type vm:CreationSlotViewModel}">
            <Border x:Name="Frame" Margin="4" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <v:CreationView Morphology="{Binding Morphology}" />

                    <StackPanel Margin="10,8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryText}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <v:Spinner />
                        <TextBlock Text="Growing…" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />

                    <Button Margin="8" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="View full screen" Click="OnFullScreen"
                            IsEnabled="{Binding CanSelect}">
                        <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                    </Button>

                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Button Content="Select" Padding="18,4"
                                ToolTip="Make this creation the current one"
                                Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                                IsEnabled="{Binding CanSelect}"
                                Visibility="{Binding IsMutant, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Re-roll" Padding="18,4"
                                Style="{DynamicResource AccentButtonStyle}"
                                ToolTip="Breed a fresh set of eight mutants (F5)"
                                Command="{Binding RerollCommand}"
                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="6,0,0,0" Padding="12,4"
                                ToolTip="{Binding KeepToolTip}" ToolTipService.ShowOnDisabled="True"
                                Command="{Binding KeepCommand}" CommandParameter="{Binding}"
                                IsEnabled="{Binding CanKeep}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Keep" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKept}" Value="True">
                                                    <Setter Property="Text" Value="Kept" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ProjectGenomeTemplate" DataType="{x:Type vm:ProjectGenomeViewModel}">
            <Border Margin="0,0,0,8" Height="190" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <v:CreationView Morphology="{Binding Morphology}" />

                    <StackPanel Margin="8,6" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryText}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Error}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="10" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />

                    <Button Margin="6" Padding="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Remove from the project"
                            Command="{Binding RemoveCommand}" CommandParameter="{Binding}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                    </Button>

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Button Content="Combine" Padding="12,4"
                                Style="{DynamicResource AccentButtonStyle}"
                                ToolTip="Cross with the current creation to breed eight offspring"
                                Command="{Binding CombineCommand}" CommandParameter="{Binding}" />
                        <Button Content="Select" Margin="6,0,0,0" Padding="12,4"
                                ToolTip="Make this the current creation"
                                Command="{Binding SelectCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:GenomeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Margin="0,3">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="18">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <Ellipse Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{Binding Swatch}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Properties}" Margin="18,1,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SecondaryText}">
                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New _project" InputGestureText="Ctrl+Shift+N" Command="{x:Static local:MainWindow.NewProjectCommand}" />
                <MenuItem Header="_Open project…" InputGestureText="Ctrl+O" Command="Open" />
                <MenuItem Header="_Save project" InputGestureText="Ctrl+S" Command="Save" />
                <MenuItem Header="Save project _as…" InputGestureText="Ctrl+Shift+S" Command="SaveAs" />
                <Separator />
                <MenuItem Header="_New random creation" InputGestureText="Ctrl+N" Command="{Binding NewRandomCommand}" />
                <MenuItem Header="_Import genome into project…" InputGestureText="Ctrl+I" Command="{x:Static local:MainWindow.ImportGenomeCommand}" />
                <MenuItem Header="_Export current genome…" InputGestureText="Ctrl+E" Command="{x:Static local:MainWindow.ExportGenomeCommand}" />
                <MenuItem Header="Export _image…" InputGestureText="Ctrl+P" Command="Print" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Evolution">
                <MenuItem Header="_Re-roll mutants" InputGestureText="F5" Command="{Binding RerollCommand}" />
                <MenuItem Header="_Back to previous" InputGestureText="Ctrl+Z" Command="{Binding BackCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings…" Click="OnSettings" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <Border Margin="10,10,0,10" Padding="10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,10">
                        <TextBlock Text="Project" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProjectName}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Grid>
                        <TextBlock Margin="4,0" Style="{StaticResource SecondaryText}"
                                   Text="Click Keep on any creation to add it to the project. Combine crosses a kept genome with the current creation."
                                   Visibility="{Binding IsProjectEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ProjectGenomes}" ItemTemplate="{StaticResource ProjectGenomeTemplate}"
                                          Focusable="False" />
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <ItemsControl Grid.Column="2" ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource SlotTemplate}" Margin="6" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="3" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="4" Margin="0,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="14" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Genome" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource SecondaryText}">
                                <Run Text="Surface: " /><Run Text="{Binding SurfaceSummary, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Style="{StaticResource SecondaryText}"
                                   Text="Drag to rotate · wheel or right-drag to zoom · middle or Shift-drag to pan · double-click to reset view" />
                        <TreeView ItemsSource="{Binding GenomeTree}" BorderThickness="0" Background="Transparent">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="True" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Margin="0,10,0,0" Padding="14" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Evolution" Style="{StaticResource SectionHeader}" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding MutationStrength, StringFormat={}{0:P0}}" />
                            <TextBlock Text="Mutation strength" Width="130" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding MutationStrength}" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding StructuralMutationRate, StringFormat={}{0:P0}}" />
                            <TextBlock Text="Structural mutations" Width="130" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding StructuralMutationRate}" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding MaxSpheres, StringFormat={}{0:N0}}" />
                            <TextBlock Text="Sphere limit" Width="130" VerticalAlignment="Center" />
                            <Slider Minimum="250" Maximum="20000" SmallChange="250" LargeChange="1000"
                                    TickFrequency="250" IsSnapToTickEnabled="True"
                                    Value="{Binding MaxSpheres}" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding MaxTextures}" />
                            <TextBlock Text="Texture limit" Width="130" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="8" SmallChange="1" LargeChange="1"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ToolTip="Most procedural textures a genome may define (0 = plain colours only)"
                                    Value="{Binding MaxTextures}" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding MaxBumpMaps}" />
                            <TextBlock Text="Bump map limit" Width="130" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="8" SmallChange="1" LargeChange="1"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ToolTip="Most procedural bump maps a genome may define (0 = smooth spheres only)"
                                    Value="{Binding MaxBumpMaps}" />
                        </DockPanel>
                        <TextBlock Text="Changes apply to the next re-roll." Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
