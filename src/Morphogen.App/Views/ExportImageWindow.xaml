<Window x:Class="Morphogen.App.Views.ExportImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export image" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Renders the current creation from its current viewing angle."
                   Style="{StaticResource SecondaryText}" Margin="0,0,0,14" />
        <TextBlock Text="Size" Style="{StaticResource SectionHeader}" />
        <ComboBox x:Name="PresetCombo" SelectionChanged="OnPresetChanged" Margin="0,0,0,10" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Width (px)" Style="{StaticResource SecondaryText}" />
                <TextBox x:Name="WidthBox" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="×" Margin="10,0" VerticalAlignment="Bottom" Padding="0,0,0,8" />
            <StackPanel Grid.Column="2">
                <TextBlock Text="Height (px)" Style="{StaticResource SecondaryText}" />
                <TextBox x:Name="HeightBox" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Export…" Width="90" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="OnExport" />
            <Button Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
